@model PerfilViewModel
<h1>Mi perfil</h1>
<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label class="form-label">Correo</label><input class="form-control" value="@Model.Email" disabled /></div>
    <div class="mb-3"><label class="form-label">Rol</label><input class="form-control" value="@Model.Rol" disabled /></div>
    <div class="mb-3"><label asp-for="NombreCompleto" class="form-label">Nombre completo</label><input asp-for="NombreCompleto" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" class="form-control" /></div>
    <button class="btn btn-primary">Guardar cambios</button>
</form>
