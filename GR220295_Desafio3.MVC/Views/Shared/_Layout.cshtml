<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bolsa de Trabajo - Gobierno de El Salvador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Bolsa de Trabajo</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Plazas" asp-action="Index">Plazas</a></li>
                    @if (User.IsInRole("Candidato"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="HojaDeVida" asp-action="Index">Mi hoja de vida</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Postulaciones" asp-action="Index">Mis postulaciones</a></li>
                    }
                    @if (User.IsInRole("Agente de Selección"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Plazas" asp-action="Crear">Nueva plaza</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Postulaciones" asp-action="Gestionar">Evaluar postulaciones</a></li>
                    }
                    @if (User.IsInRole("Administrador"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Administrador" asp-action="Index">Administración</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Postulaciones" asp-action="Gestionar">Postulaciones</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Perfil">Hola, @User.Identity.Name</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Logout">Cerrar sesión</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Registro">Registrarse</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
<main class="container py-4">
    @if (TempData["Mensaje"] is not null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @RenderBody()
</main>
<footer class="border-top py-3 text-muted">
    <div class="container">GR220295_Desafio3 - Desarrollo de Software Empresarial</div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
