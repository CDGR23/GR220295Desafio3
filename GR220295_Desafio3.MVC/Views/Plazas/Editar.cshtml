@model PlazaViewModel
@{ var edicion = Model.IdPlaza > 0; }
<h1>@(edicion ? "Editar plaza" : "Crear plaza")</h1>
<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <input asp-for="IdPlaza" type="hidden" />
    <div class="mb-3"><label asp-for="Titulo" class="form-label">Título</label><input asp-for="Titulo" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Descripcion" class="form-label">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="5"></textarea></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="FechaPublicacion" class="form-label">Fecha de publicación</label><input asp-for="FechaPublicacion" class="form-control" type="datetime-local" /></div>
    <div class="col-md-6 mb-3"><label asp-for="FechaCierre" class="form-label">Fecha de cierre</label><input asp-for="FechaCierre" class="form-control" type="datetime-local" /></div></div>
    <div class="mb-3"><label asp-for="Institucion" class="form-label">Institución</label><input asp-for="Institucion" class="form-control" /></div>
    <button class="btn btn-primary">Guardar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
